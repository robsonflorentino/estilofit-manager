# ─────────────────────────────────────────────────────────────────────────────
# EstiloFit Manager — variáveis de produção
# Copie para .env.prod e preencha com valores reais. NUNCA versione o .env.prod.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ───────────────────────────────────────────────────────────
DB_NAME=estilofit_manager
DB_USERNAME=estilofit
# Use uma senha forte (ex.: openssl rand -base64 24)
DB_PASSWORD=troque_esta_senha

# ── Segurança / JWT ──────────────────────────────────────────────────────────
# Segredo do JWT — OBRIGATÓRIO e forte. Gere com: openssl rand -base64 48
JWT_SECRET=troque_este_segredo_por_um_valor_longo_e_aleatorio
JWT_ACCESS_TOKEN_EXPIRATION=28800
JWT_REFRESH_TOKEN_EXPIRATION=604800

# ── Cookie do refresh token ──────────────────────────────────────────────────
# true em produção (exige HTTPS). Só use false se rodar sem HTTPS (não recomendado).
COOKIE_SECURE=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Como o frontend é servido na mesma origem (nginx faz proxy de /api), o CORS
# raramente é necessário. Se acessar a API de outra origem, liste-a aqui.
CORS_ALLOWED_ORIGINS=https://seu-dominio.com.br

# ── Documentação da API ──────────────────────────────────────────────────────
SWAGGER_ENABLED=false

# ── Porta pública do frontend (nginx) ────────────────────────────────────────
# Deixe 80 e coloque um proxy reverso com HTTPS na frente (ver docs/deploy.md).
WEB_PORT=80
