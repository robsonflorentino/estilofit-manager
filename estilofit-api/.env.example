# ── Aplicação ──────────────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development

# ── Banco de Dados ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estilofit_manager
DB_USERNAME=estilofit
DB_PASSWORD=estilofit123

# ── JWT ────────────────────────────────────────────────────────────────────
# Gere um secret seguro com: openssl rand -base64 64
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64
# Duração do access token em segundos (padrão: 8 horas)
JWT_ACCESS_TOKEN_EXPIRATION=28800
# Duração do refresh token em segundos (padrão: 7 dias)
JWT_REFRESH_TOKEN_EXPIRATION=604800

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Swagger ────────────────────────────────────────────────────────────────
# Defina como false em produção
SWAGGER_ENABLED=true

# ── Logs ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
